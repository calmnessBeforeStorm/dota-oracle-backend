# --- App ---
APP_ENV=local                 # local | development | production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8100
CORS_ORIGINS=http://localhost:5273

# Ports below are the HOST side: what you connect to from your machine and what
# docker compose publishes. Inside the compose network the services always use the
# stock 5432/6379/8000, overridden there explicitly.

# --- PostgreSQL 16 ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5442
POSTGRES_DB=dota_oracle
POSTGRES_USER=dota
POSTGRES_PASSWORD=dota

# --- Redis 7 ---
REDIS_HOST=localhost
REDIS_PORT=6389
REDIS_DB=0

# --- External sources (spec section 2) ---
# A: OpenDota - key optional, raises the free quota
OPENDOTA_API_KEY=
# B: STRATZ - Bearer token from stratz.com
STRATZ_API_TOKEN=
# C: Steam Web API - https://steamcommunity.com/dev/apikey (REQUIRED for live)
STEAM_API_KEY=
# D: Liquipedia - custom User-Agent with project name + contact email is MANDATORY
LIQUIPEDIA_USER_AGENT=dota-oracle/0.1 (contact@example.com)

# --- Live loop cadence, seconds (spec section 2.4) ---
LIVE_LEAGUE_POLL_INTERVAL=30
LIVE_REALTIME_POLL_INTERVAL=15

# --- ML ---
MODEL_DIR=./models
ACTIVE_MODEL_VERSION=
