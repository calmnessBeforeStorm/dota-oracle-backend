# Production environment. Copy to /opt/dota-oracle/.env, fill in, then `chmod 600 .env`.
#
# This file is the template and carries no values. The real one never enters git - it is in
# .gitignore, deploy.sh refuses to run unless it is mode 600, and nothing in the repository
# names the host, the password or a key.

# --- what to deploy ---
# GitHub account or organisation that owns the packages, lowercase.
IMAGE_OWNER=
# `main` follows the branch, and both images move together on every deploy - which is what
# keeps the SPA and the API in step.
IMAGE_TAG=main
# Only for a rollback, and then both at once. The two repositories have separate histories,
# so no single SHA names a matching pair; ./deploy.sh <api-sha> <spa-sha> sets these for one
# run without editing this file.
# API_TAG=
# FRONTEND_TAG=

# --- front door ---
# Bare domain. Caddy also serves www. of it, and issues the certificate for both, so the A
# records for each must point straight here - DNS only, the grey cloud in Cloudflare. Behind
# the orange cloud the ACME challenge never reaches Caddy and no certificate is issued.
DOMAIN=
# A real mailbox: Let's Encrypt sends expiry warnings to it.
ACME_EMAIL=

# --- database ---
POSTGRES_DB=dota_oracle
POSTGRES_USER=dota
# Generate, do not invent: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- data sources ---
# Steam is required; the poller is the whole live product and it cannot start without a key.
STEAM_API_KEY=
# STRATZ backfills match details and resolves outcomes. Without it the accuracy dashboard
# stays empty, because nothing tells us how a predicted match ended.
STRATZ_API_TOKEN=
# OpenDota works unauthenticated at a lower rate limit; a key only raises it.
#
# On this server it matters more than it looks: with STRATZ unavailable, OpenDota is where
# every prediction's outcome comes from, one request per match. Without a key the daily
# allowance ran out after 685 matches in an earlier measurement, and the server predicts
# roughly that many distinct matches a day - so without one, the oldest unscored matches
# are the ones that never get scored.
OPENDOTA_API_KEY=

# Whether STRATZ answers from this host. It does not, on this server: measured 2026-09-11,
# every request returned 403 with a Cloudflare HTML page, using a token verified identical to
# one that returned 200 from a residential connection. A block on the network, so no header
# or retry changes it.
#
# false: outcomes are resolved from OpenDota, and the STRATZ details backfill is not
# scheduled - training runs where STRATZ is reachable and the model file is copied here.
STRATZ_AVAILABLE=false
# Liquipedia's terms require a real contact address in the User-Agent. Breaking them is an
# IP ban, and the tier markup goes with it.
LIQUIPEDIA_USER_AGENT=dota-oracle/1.0 (contact@example.com)

# --- model ---
# The version to serve. Its artifact and card must both be in ./models or deploy.sh stops:
#   models/<version>.txt
#   models/<version>.card.json
# Promotion stays a human action. A model that promotes itself eventually promotes a
# regression, and the numbers on the public dashboard come from this file's choice.
ACTIVE_MODEL_VERSION=
