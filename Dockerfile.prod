# Production image: the SPA and the API in one artifact.
#
# **The build context is the directory that holds both repositories**, not this one, because
# the frontend lives in a sibling checkout and Docker cannot reach outside its context.
# `docker-compose.prod.yml` sets that up; by hand it is:
#
#     cd .. && docker build -f dota-oracle-backend/Dockerfile.prod -t dota-oracle .
#
# One image rather than two was a deliberate choice: the SPA is useless without this exact
# API and the API is not a public product, so versioning them apart would mean tracking a
# compatibility matrix nobody wants to own.

FROM node:22-slim AS spa

WORKDIR /spa
COPY dota-oracle-frontend/package.json dota-oracle-frontend/package-lock.json ./
RUN npm ci
COPY dota-oracle-frontend/ ./
# Same-origin in production, so the SPA calls /api and /ws on whatever host serves it and
# needs no base URL baked in.
RUN npm run build


FROM python:3.12-slim AS api

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# build-essential is needed to install, not to run, so it goes no further than this stage.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY dota-oracle-backend/pyproject.toml dota-oracle-backend/README.md ./
COPY dota-oracle-backend/app ./app
RUN pip install --upgrade pip && pip install .


FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx curl \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default

COPY --from=api /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=api /usr/local/bin /usr/local/bin
COPY dota-oracle-backend/app ./app
COPY dota-oracle-backend/alembic.ini ./
COPY dota-oracle-backend/alembic ./alembic
COPY --from=spa /spa/dist /srv/spa

COPY dota-oracle-backend/deploy/nginx.conf /etc/nginx/conf.d/dota-oracle.conf
COPY dota-oracle-backend/deploy/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 80

# Through nginx, not straight at uvicorn: this checks the path a visitor actually takes, so a
# broken proxy config fails the healthcheck instead of hiding behind a healthy API.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fsS http://localhost/api/health || exit 1

CMD ["/usr/local/bin/entrypoint.sh"]
