# Production image: the API and the worker, nothing else.
#
# The context is this repository alone. An earlier version built the SPA into the same image
# from a sibling checkout, which meant the build could only run on a machine holding both
# repositories - impossible in GitHub Actions, where a job checks out one repo. The SPA now
# builds in its own repository and Caddy puts the two behind one origin, so the SPA still
# calls /api and /ws with no base URL compiled in and no CORS to configure.
#
# Splitting them does reintroduce the risk the single image existed to avoid: an SPA and an
# API that drift apart. The deploy pins both to the same tag and moves them together, so
# there is still no compatibility matrix to own - see deploy/docker-compose.prod.yml.

FROM python:3.12-slim AS build

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# build-essential is needed to install, not to run, so it stays in this stage and never
# reaches the image that faces the internet.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md LICENSE ./
COPY app ./app
# A real install, not `-e`: the editable path leaves the source tree as the import root,
# which is right for development and wrong for an artifact that must be identical wherever
# it lands.
RUN pip install --upgrade pip && pip install .


FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# curl is here for the healthcheck and nothing else.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 app

COPY --from=build /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=build /usr/local/bin /usr/local/bin
COPY app ./app
COPY alembic.ini ./
COPY alembic ./alembic

# Nothing in here writes to its own filesystem: state is in Postgres, Redis and the mounted
# model directory. Running as a non-root user costs nothing and removes a whole class of
# "container escape" from the conversation.
USER app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fsS http://localhost:8000/api/health || exit 1

# Behind Caddy, so uvicorn binds every interface inside the container network and trusts the
# forwarded headers it is given - without those the client IP in the logs is Caddy's.
CMD ["uvicorn", "app.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--proxy-headers", \
     "--forwarded-allow-ips", "*"]
