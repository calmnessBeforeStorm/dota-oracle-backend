# Production image: the API and the worker, nothing else.
#
# The context is this repository alone. An earlier version built the SPA into the same image
# from a sibling checkout, which meant the build could only run on a machine holding both
# repositories - impossible in GitHub Actions, where a job checks out one repo. The SPA now
# builds in its own repository and Caddy puts the two behind one origin, so the SPA still
# calls /api and /ws with no base URL compiled in and no CORS to configure.
#
# Splitting them does reintroduce the risk the single image existed to avoid: an SPA and an
# API that drift apart. The deploy pins both to the same tag and moves them together, so
# there is still no compatibility matrix to own - see deploy/docker-compose.prod.yml.

FROM python:3.12-slim AS build

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# build-essential is needed to install, not to run, so it stays in this stage and never
# reaches the image that faces the internet.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md LICENSE ./
COPY app ./app
# A real install, not `-e`: the editable path leaves the source tree as the import root,
# which is right for development and wrong for an artifact that must be identical wherever
# it lands.
RUN pip install --upgrade pip && pip install .


FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# curl for the healthcheck, libgomp1 for LightGBM.
#
# libgomp1 is the OpenMP runtime that LightGBM links against. It arrives in the build
# stage as a dependency of build-essential and does not survive the copy into this one,
# so the image imported everything except the thing it exists to serve:
#
#     model.load_failed: libgomp.so.1: cannot open shared object file
#     model.baseline_fallback
#
# The service keeps answering, on the baseline, which is exactly the danger: the site
# looked healthy while serving a two-feature logistic regression under the trained
# model's name. This is the second serving image in this project unable to load a
# booster - the first had lightgbm itself in an optional extra.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 app

COPY --from=build /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=build /usr/local/bin /usr/local/bin
COPY app ./app
COPY alembic.ini ./
COPY alembic ./alembic

# Nothing in here writes to its own filesystem: state is in Postgres, Redis and the mounted
# model directory. Running as a non-root user costs nothing and removes a whole class of
# "container escape" from the conversation.
USER app

EXPOSE 8000

# 127.0.0.1, not localhost. The image resolves `localhost` to both 127.0.0.1 and ::1,
# while uvicorn binds IPv4 only - so a client that picks the v6 address is refused by a
# perfectly healthy process. Measured in this image: curl to localhost:8000 prints
# "Failed to connect to localhost port 8000", the same line that showed up mid-deploy.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/api/health || exit 1

# Behind Caddy, so uvicorn binds every interface inside the container network and trusts the
# forwarded headers it is given - without those the client IP in the logs is Caddy's.
CMD ["uvicorn", "app.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--proxy-headers", \
     "--forwarded-allow-ips", "*"]
